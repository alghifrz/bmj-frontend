# Public Go API origin, without a trailing slash.
# Example: http://localhost:8080
NEXT_PUBLIC_API_URL=

# WhatsApp number in international format, digits only.
# Example: 6281234567890
# Leave empty until the official BMJ number is available.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Public site origin used for metadata. Example: https://www.buanamedikajaya.com
NEXT_PUBLIC_SITE_URL=

# Google Analytics 4 measurement ID. Example: G-XXXXXXXXXX
# Leave empty until the GA4 property exists. Visitor counts still appear in the admin dashboard.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
